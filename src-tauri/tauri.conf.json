{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox Launcher",
  "version": "0.3.1",
  "identifier": "com.vox.launcher",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vox Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://cdn.modrinth.com; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Sylphira",
    "copyright": "Copyright (c) Sylphira. Licensed under GPL-3.0.",
    "shortDescription": "Vox Launcher - a Minecraft: Java Edition launcher",
    "longDescription": "Vox Launcher is a fast launcher for Minecraft: Java Edition with instances, mods, modpacks, skins and more. Not affiliated with Mojang or Microsoft.",
    "homepage": "https://github.com/sylphiras/vox-launcher"
  }
}
